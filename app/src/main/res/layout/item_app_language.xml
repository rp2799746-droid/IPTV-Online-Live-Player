<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main_view"
    android:layout_width="match_parent"
    android:layout_height="60dp"
    android:layout_marginHorizontal="6.50dp"
    android:layout_marginVertical="6.50dp"
    android:background="@drawable/set_lan"
    android:orientation="horizontal">

    <ImageView
        android:id="@+id/flag_iv"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_centerVertical="true"
        android:layout_marginHorizontal="10dp"
        android:contentDescription="@null"
        android:visibility="gone" />


    <ImageView
        android:id="@+id/lan_selection"
        android:layout_width="@dimen/_14sdp"
        android:layout_height="@dimen/_14sdp"
        android:layout_alignParentStart="true"
        android:layout_centerVertical="true"
        android:layout_marginHorizontal="@dimen/_15sdp"
        android:layout_marginVertical="5dp"
        android:contentDescription="selected"
        android:src="@drawable/selectun" />

    <TextView
        android:id="@+id/lan_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_marginStart="@dimen/_10sdp"
        android:layout_toEndOf="@+id/lan_selection"
        android:fontFamily="@font/sf_pro_text_medium"
        android:gravity="center"
        android:text="English"
        android:textColor="@color/black"
        android:textSize="14sp" />

    <!--
        Language pasand karvanu suchan (hand-click). Swipe hint puro thay pachi
        J dekhay chhe ane koi language click karta gayab thai jay chhe.
        - LanguageAdapter.setShowClickHint() thi control thay chhe.
    -->
    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/click_hint"
        android:layout_width="@dimen/_200sdp"
        android:layout_height="@dimen/_200sdp"
        android:layout_alignParentEnd="true"
        android:layout_centerVertical="true"
        android:contentDescription="@null"
        android:visibility="gone"
        app:lottie_autoPlay="true"
        app:lottie_loop="true"
        android:layout_marginEnd="-30dp"
        android:layout_marginBottom="-40dp"
        app:lottie_rawRes="@raw/swipeup" />

</RelativeLayout>
