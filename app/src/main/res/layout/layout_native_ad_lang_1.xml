<?xml version="1.0" encoding="utf-8"?>

<com.google.android.gms.ads.nativead.NativeAdView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="0dp"
    tools:ignore="HardcodedText,SpUsage">

    <androidx.cardview.widget.CardView
        android:id="@+id/ad_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="0dp"
        app:cardBackgroundColor="@android:color/transparent"
        app:cardCornerRadius="0dp"
        app:cardElevation="0dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="8dp">

            <!-- CTR fix: text section (icon thi body sudhi) mate full-width light gray background -->
            <View
                android:id="@+id/ad_content_bg"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:background="#F2F2F2"
                app:layout_constraintBottom_toBottomOf="@id/barrier_top"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- Logo: daabi baju. Title + content aa logo ni height ma j fit thay (sample jevu) -->
            <ImageView
                android:id="@+id/ad_app_icon"
                android:layout_width="@dimen/_44sdp"
                android:layout_height="@dimen/_44sdp"
                android:layout_marginStart="@dimen/_10sdp"
                android:layout_marginTop="@dimen/_8sdp"
                android:adjustViewBounds="true"
                android:contentDescription="@null"
                android:scaleType="fitCenter"
                android:src="@color/Hover71"
                android:visibility="visible"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- Title + body ek vertical chain (spread_inside) chhe:
                 title top = logo top, body ni chhelli line = logo bottom -->
            <TextView
                android:id="@+id/ad_headline"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_8sdp"
                android:layout_marginEnd="8dp"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/black"
                android:textSize="@dimen/_11ssp"
                android:textStyle="bold"
                app:layout_constraintBottom_toTopOf="@id/ad_body"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/ad_app_icon"
                app:layout_constraintTop_toTopOf="@id/ad_app_icon"
                app:layout_constraintVertical_chainStyle="spread_inside"
                tools:text="Jotun Viet Nam" />

            <!-- "Ad" badge: body ni pehli line ni daabi baju -->
            <TextView
                android:id="@+id/ad_icon"
                android:layout_width="18dp"
                android:layout_height="17dp"
                android:layout_marginTop="1dp"
                android:background="#2D7BFF"
                android:gravity="center"
                android:includeFontPadding="false"

                android:text="Ad"


                android:textColor="@color/white"
                android:textSize="@dimen/_7ssp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="@id/ad_headline"
                app:layout_constraintTop_toTopOf="@id/ad_body" />

            <!-- Body: "Ad" badge na jamne, 2 line, chhelli line logo ni neechi dhaar sathe -->
            <TextView
                android:id="@+id/ad_body"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:lineSpacingExtra="1dp"
                android:maxLines="2"
                android:textColor="@color/black"
                android:textSize="@dimen/_9ssp"
                app:layout_constraintBottom_toBottomOf="@id/ad_app_icon"
                app:layout_constraintEnd_toEndOf="@id/ad_headline"
                app:layout_constraintStart_toEndOf="@id/ad_icon"
                app:layout_constraintTop_toBottomOf="@id/ad_headline"
                tools:text="Son noi that sieu cao cap Majestic dep nguyen ban cua..." />

            <!-- Advertiser: sample ma nathi. Library bind kare to crash na thay e mate id rakhyo,
                 pan 0 size ane gone chhe etle layout ma kai dekhatu nathi. -->
            <TextView
                android:id="@+id/ad_advertiser"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="parent" />

            <androidx.constraintlayout.widget.Barrier
                android:id="@+id/barrier_top"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:barrierDirection="bottom"
                app:barrierMargin="@dimen/_8sdp"
                app:constraint_referenced_ids="ad_app_icon,ad_body" />

            <com.google.android.gms.ads.nativead.MediaView
                android:id="@+id/ad_media"
                android:layout_width="0dp"
                android:layout_height="@dimen/_92sdp"
                android:layout_marginHorizontal="0dp"
                android:layout_marginTop="@dimen/_5sdp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/barrier_top" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/ad_call_to_action"
                android:layout_width="0dp"
                android:layout_height="@dimen/_42sdp"
                android:layout_marginTop="@dimen/_7sdp"
                android:layout_marginBottom="4dp"
                android:background="@drawable/bg_btn_native_cta_review"
                android:tag="fixed_cta_height"
                android:textAllCaps="false"
                android:textColor="#ffffff"
                android:textSize="@dimen/_13ssp"
                android:textStyle="bold"
                android:layout_marginHorizontal="8dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/ad_media"
                tools:text="Install" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>
</com.google.android.gms.ads.nativead.NativeAdView>
